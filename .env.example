# LLM backend: mock | ollama | gemini
LLM_BACKEND=mock
# Ollama (default model per spec; verify exact tag with `ollama list`)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
# Offline fallback if the primary model is unreachable
OLLAMA_FALLBACK_MODEL=gemma3:1b
# Faster model used only for live phone-call turns (keeps latency low)
OLLAMA_FAST_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT_S=60

# Gemini API (Gemma 4 via Gemini API). Get key from Google AI Studio.
# Verified model IDs: gemma-4-31b-it, gemma-4-26b-a4b-it
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it

# Messaging: mock | telegram | whatsapp
MESSAGING_BACKEND=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Twilio / WhatsApp sandbox (shared sandbox number +14155238886; join <code>)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Or API-key auth (preferred for least privilege): username=key SID, password=secret
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TEMPLATE_EVENT_INQUIRY=Your appointment is coming up on {{1}} at {{2}}

# Voice: mock | elevenlabs
CALL_BACKEND=mock
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
CALL_TO_NUMBER=+91XXXXXXXXXX
CALL_MAX_DURATION_S=180
CALL_MAX_PER_EVENT=5

# App
DATABASE_URL=sqlite:///./eventops.db
EVENT_TIMEZONE=Asia/Kolkata
APP_PORT=8000
# Demo content lives in seed.json (override path) — no names in code
SEED_FILE=./seed.json
# Local overrides go in .env.local (gitignored, wins over .env)
# Browser frontend origin(s) allowed to call the API (comma-separated)
FRONTEND_URL=http://localhost:3000

# Auth (demo-grade passcodes; change for anything beyond local demo)
AUTH_SECRET=change-me-to-something-random
DEMO_ORG_PASS=1111
DEMO_MEMBER_PASS=2222

# Research worker
RESEARCH_LOOP=1
SEARCH_BACKEND=local
